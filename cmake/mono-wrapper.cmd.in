@echo off
rem Runs the freshly built runtime out of the build tree, with the build tree's
rem own dllmap configuration.  The Windows spelling of cmake/mono-wrapper.in.
rem
rem MONO_EXECUTABLE names which collector's binary to run, so a test matrix can
rem pick one without the caller knowing where the build put it.

setlocal EnableExtensions

set "MONO_CFG_DIR=@MONO_BUILD_CFG_DIR@"

rem Windows excludes the dllmap entries for these libraries. Add their build
rem directories to PATH so the OS loader can find them.
set "PATH=@MONO_BUILD_ROOT@\runtime\_tmpinst\bin;@MONO_BUILD_ROOT@\support;@MONO_BUILD_ROOT@\mono\btls;%PATH%"

if not defined MONO_EXECUTABLE set "MONO_EXECUTABLE=@MONO_RUNTIME_BINARY@"
if not defined MONO_EXECUTABLE_WRAPPER set "MONO_EXECUTABLE_WRAPPER=%MONO_EXECUTABLE%"

"%MONO_EXECUTABLE_WRAPPER%" --config "%MONO_CFG_DIR%\mono\config" %*
exit /b %ERRORLEVEL%
