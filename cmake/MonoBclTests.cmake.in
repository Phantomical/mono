# Generated by MonoManagedTests.cmake -- do not edit.
#
# Registers the CTest tests for @_testname@.  It is named in TEST_INCLUDE_FILES,
# so CTest reads it on every run and the build only has to rewrite the group
# list beside it.
#
# With no group list -- before the first build, or when the listing failed --
# the suite is one test running the whole assembly, which is what it was before
# it could be split.

set(_bcl_command [==[@_command@]==])
set(_bcl_env [==[@_env@]==])

# Adds one test.  `suffix` distinguishes its result XML, since the groups run in
# parallel and would otherwise write over each other; the remaining arguments
# are the filter that selects the group.
function(_bcl_add name suffix timeout)
  if("@_kind@" STREQUAL "nunit")
    set(_result "-result:@_resultbase@${suffix}.xml")
  else()
    set(_result "-nunit" "@_resultbase@${suffix}.xml")
  endif()
  # CTest reads this file with its own add_test(), which only has the old
  # positional form -- no NAME/COMMAND, and no WORKING_DIRECTORY.
  add_test("${name}" ${_bcl_command} ${_result} ${ARGN})
  set_tests_properties("${name}" PROPERTIES
    WORKING_DIRECTORY "@_workdir@"
    LABELS "@_label@"
    TIMEOUT "${timeout}"
    SKIP_REGULAR_EXPRESSION "@_skiprx@"
    FIXTURES_REQUIRED fx_@_testname@
    ENVIRONMENT "${_bcl_env}")
endfunction()

set(BCL_GROUP_COUNT 0)
set(BCL_CATCHALL_ARGS "")
# The @_split@ guard is what taking a suite back out of MONO_BCL_TESTS_SPLIT
# does: a group list left behind by an earlier build is ignored rather than
# quietly keeping the suite split.
if(@_split@ AND EXISTS "@_groupfile@")
  include("@_groupfile@")
endif()

if(BCL_GROUP_COUNT EQUAL 0)
  _bcl_add("@_testname@" "" @_timeout@)
else()
  math(EXPR _bcl_last "${BCL_GROUP_COUNT} - 1")
  foreach(_bcl_i RANGE ${_bcl_last})
    string(MAKE_C_IDENTIFIER "${BCL_GROUP_${_bcl_i}_NAME}" _bcl_suffix)
    _bcl_add("@_testname@/${BCL_GROUP_${_bcl_i}_NAME}" "-${_bcl_suffix}"
             @_group_timeout@ ${BCL_GROUP_${_bcl_i}_ARGS})
  endforeach()
  if(BCL_CATCHALL_ARGS)
    _bcl_add("@_testname@/unlisted" "-unlisted" @_group_timeout@ ${BCL_CATCHALL_ARGS})
  endif()
endif()
